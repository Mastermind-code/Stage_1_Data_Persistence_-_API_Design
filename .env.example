# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# GitHub OAuth App credentials (Web Portal)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# The callback URL registered in your Web Portal GitHub OAuth App
REDIRECT_URI=https://your-backend.vercel.app/auth/github/callback

# GitHub OAuth App credentials (CLI — separate app with callback: http://localhost:8765)
GITHUB_CLI_CLIENT_ID=your_cli_github_client_id
GITHUB_CLI_CLIENT_SECRET=your_cli_github_client_secret

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key

# URLs
BACKEND_URL=https://your-backend.vercel.app
WEB_PORTAL_URL=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
